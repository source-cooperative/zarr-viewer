# Sentry error monitoring.
# The DSN is public and write-only. Leave it unset to disable Sentry locally
# (the app runs normally and sends nothing). Copy this file to `.env` and fill
# in the DSN to test error capture in development.
VITE_SENTRY_DSN=

# Release identifier reported to Sentry. In CI this is set to the git SHA so it
# matches the uploaded source maps; usually left unset locally.
VITE_SENTRY_RELEASE=
